# ==========================================================================
# Plantilla de variables de entorno. COPIALA como `.env.local` (que git IGNORA)
# y completá los valores reales SOLO ahí y en Vercel (Settings > Environment
# Variables). NUNCA pongas credenciales reales en este archivo ni en el código.
# ==========================================================================

# A3 / Cocos xOMS (API Primary de trading). Base de la API del broker.
A3_API_BASE=https://api.cocos.xoms.com.ar

# Usuario y contraseña de tu cuenta de broker (los cargás vos en Vercel/.env.local).
A3_USERNAME=
A3_PASSWORD=

# Supabase (Postgres con los datos históricos: DJVE, lineups, compras, etc.).
# La URL y la clave publishable son PÚBLICAS por diseño (las tablas están
# protegidas por RLS de solo-lectura), pero igual van solo en .env.local y en
# Vercel > Environment Variables. Proyecto Supabase: lineup-argentina.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publishable (formato sb_publishable_...), rol anónimo de solo lectura.
SUPABASE_ANON_KEY=
# Clave service_role (ESCRITURA). SECRETA de verdad: SOLO para los jobs de ingesta
# (scripts/ + GitHub Actions), NUNCA en la web ni en el repo. Supabase > Settings > API.
SUPABASE_SERVICE_KEY=

# --------------------------------------------------------------------------
# LOGIN / Supabase Auth (ver docs/PLAN_LOGIN.md y docs/GUIA_LOGIN_SETUP.md).
# El SDK de Auth corre también en el navegador → necesita el prefijo NEXT_PUBLIC_.
# Son las MISMAS credenciales que arriba (URL + clave publishable/anon), solo con
# otro nombre; son públicas por diseño (RLS protege las filas).
# --------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Interruptor del login. APAGADO por defecto: la web sigue pública como hoy.
# Poné "true" (en Vercel) SOLO cuando hayas probado todo el flujo y quieras cerrar
# la web detrás del login. Cualquier otro valor (o vacío) = login apagado.
AUTH_ENFORCED=false

# URL pública del sitio, para los enlaces de los emails de Supabase (confirmación de
# cuenta, recupero de contraseña) y el callback de OAuth. En local podés dejarla vacía
# (se infiere del host). En Vercel: https://rofoagro-research-web.vercel.app
NEXT_PUBLIC_SITE_URL=

# --------------------------------------------------------------------------
# LOGIN Etapa 2 (panel admin + emails). Ver docs/GUIA_LOGIN_SETUP.md.
# --------------------------------------------------------------------------
# Resend (emails transaccionales del login). Sin esta key, el login NO se rompe:
# los avisos por email simplemente no se envían (quedan logueados en el servidor).
RESEND_API_KEY=
# Remitente de los emails. Para que llegue a cualquier casilla necesitás un dominio
# verificado en Resend (ej. "ROFO AGRO <research@tudominio.com>"). Sin dominio propio,
# Resend solo permite mandarte a vos mismo con onboarding@resend.dev (default de prueba).
RESEND_FROM=
# Emails de los admins que reciben el aviso de "registro nuevo para aprobar"
# (coma-separados). Ej: lautaroronchi97@gmail.com,mauro@ejemplo.com
ADMIN_EMAILS=lautaroronchi97@gmail.com

# --------------------------------------------------------------------------
# Panel /admin/conexiones (monitoreo de crons, Routines y cargas manuales).
# --------------------------------------------------------------------------
# Token de GitHub SOLO LECTURA para ver el último run real de cada workflow (verde/rojo/
# hora/link). Sin esta variable el panel sigue funcionando: degrada a mostrar solo la
# frescura del dato en Supabase (no el resultado del run en sí).
# Cómo crearlo: GitHub → tu foto de perfil → Settings → Developer settings →
# Personal access tokens → Fine-grained tokens → Generate new token.
#   - Resource owner: el dueño del repo (lautaroronchi97-commits)
#   - Repository access: Only select repositories → ROFOAGRO_RESEARCH_WEB
#   - Permissions → Repository permissions → Actions: Read-only (el resto queda en "No access")
# Cargalo SOLO en Vercel (Settings > Environment Variables, scope Production) — nunca en el repo.
GH_MONITOR_TOKEN=
